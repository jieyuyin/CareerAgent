#!/bin/sh
set -eu

ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$ROOT_DIR"

if ! command -v docker >/dev/null 2>&1; then
  echo "CareerAgent 需要 Docker Desktop 或 Docker Engine：https://docs.docker.com/get-docker/"
  exit 1
fi

if ! docker info >/dev/null 2>&1; then
  echo "Docker 尚未启动，请先启动 Docker Desktop/Engine。"
  exit 1
fi

if [ ! -f .env ]; then
  cp .env.example .env
  echo "已根据 .env.example 创建 .env。正式部署前请修改其中的默认密码。"
fi

command_name=${1:-up}
case "$command_name" in
  up|start)
    docker compose up -d --build
    echo "CareerAgent 正在启动：http://localhost:${WEB_PORT:-5173}"
    echo "查看进度：./career-agent status，查看日志：./career-agent logs"
    ;;
  down|stop)
    docker compose down
    ;;
  restart)
    docker compose down
    docker compose up -d --build
    ;;
  logs)
    docker compose logs -f --tail=200
    ;;
  status|ps)
    docker compose ps
    ;;
  update)
    docker compose pull
    docker compose up -d --build
    ;;
  *)
    echo "用法：./career-agent {up|down|restart|logs|status|update}"
    exit 2
    ;;
esac
